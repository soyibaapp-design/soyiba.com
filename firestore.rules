rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUserProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function currentUserIsActive() {
      return currentUserProfile().get('active', false) == true
        || currentUserProfile().get('active', '') == 'true'
        || currentUserProfile().get('active', '') == 'TRUE'
        || currentUserProfile().get('active', '') == '1'
        || currentUserProfile().get('active', '') == 'active'
        || currentUserProfile().get('active', '') == 'Activo'
        || currentUserProfile().get('status', '') == 'active';
    }

    function currentUserStatusIsActive() {
      return currentUserEstadoUsuario() == 'Activo'
        || currentUserEstadoUsuario() == 'active'
        || currentUserProfile().get('status', '') == 'active';
    }

    function currentUserEstadoUsuario() {
      return currentUserProfile().get('estadoUsuario', currentUserProfile().get('estado_usuario', ''));
    }

    function currentUserRolSistema() {
      return currentUserProfile().get('rolSistema', currentUserProfile().get('rol_sistema', currentUserProfile().get('role', '')));
    }

    function currentUserTipoUsuario() {
      return currentUserProfile().get('tipoUsuario', currentUserProfile().get('tipo_usuario', ''));
    }

    function currentUserIsManagerRole() {
      return currentUserRolSistema() in ['Admin', 'Moderador', 'admin', 'moderador'];
    }

    function currentUserCanValidateMinorsRole() {
      return currentUserIsManagerRole()
        || currentUserProfile().get('minorValidator', false) == true
        || currentUserProfile().get('minorValidator', '') == 'true'
        || currentUserProfile().get('minor_validator', false) == true
        || currentUserProfile().get('minor_validator', '') == 'true';
    }

    function isManager() {
      return signedIn()
        && currentUserIsActive()
        && currentUserStatusIsActive()
        && currentUserIsManagerRole();
    }

    function isActiveMember() {
      return signedIn()
        && currentUserIsActive()
        && currentUserStatusIsActive()
        && currentUserTipoUsuario() in ['Miembro', 'miembro'];
    }

    function canValidateMinors() {
      return signedIn()
        && currentUserIsActive()
        && currentUserStatusIsActive()
        && currentUserCanValidateMinorsRole();
    }

    function isVisibleDirectoryMember() {
      return resource.data.active == true
        && resource.data.estadoUsuario == 'Activo'
        && resource.data.tipoUsuario == 'Miembro'
        && resource.data.visibleDirectorio == true;
    }

    function membershipClaimAfter() {
      return getAfter(/databases/$(database)/documents/memberRegistry/$(request.resource.data.ccHash)).data;
    }

    function isSelfMembershipUpdate(userId) {
      return signedIn()
        && request.auth.uid == userId
        && request.resource.data.email == resource.data.email
        && request.resource.data.id == resource.data.id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'role',
          'tipoUsuario',
          'tituloUsuario',
          'rolSistema',
          'estadoUsuario',
          'status',
          'active',
          'ccHash',
          'ccLast4',
          'miembroValidadoAt',
          'miembroValidadoPor',
          'miembroValidacionEstado',
          'miembroValidacionNotas',
          'visibleDirectorio',
          'updatedAt',
          'updatedAtServer'
        ])
        && request.resource.data.ccHash is string
        && membershipClaimAfter().active == true
        && membershipClaimAfter().claimedUserId == request.auth.uid
        && membershipClaimAfter().claimedEmailHash == currentUserProfile().emailHash
        && membershipClaimAfter().claimStatus == request.resource.data.miembroValidacionEstado
        && (
          (
            request.resource.data.miembroValidacionEstado == 'validado'
            && request.resource.data.role == 'Miembro'
            && request.resource.data.tipoUsuario == 'Miembro'
            && request.resource.data.tituloUsuario == 'Miembro'
            && request.resource.data.rolSistema == 'Miembro'
            && request.resource.data.estadoUsuario == 'Activo'
            && request.resource.data.status == 'active'
            && request.resource.data.active == true
            && request.resource.data.visibleDirectorio is bool
          )
          || (
            request.resource.data.miembroValidacionEstado == 'pendiente_revision'
            && request.resource.data.role == resource.data.role
            && request.resource.data.tipoUsuario == resource.data.tipoUsuario
            && request.resource.data.tituloUsuario == resource.data.tituloUsuario
            && request.resource.data.rolSistema == resource.data.rolSistema
            && request.resource.data.estadoUsuario == resource.data.estadoUsuario
            && request.resource.data.status == resource.data.status
            && request.resource.data.active == resource.data.active
          )
        );
    }

    function isSelfPhotoUpdate(userId) {
      return signedIn()
        && request.auth.uid == userId
        && request.resource.data.email == resource.data.email
        && request.resource.data.id == resource.data.id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'photoUrl',
          'updatedAt',
          'updatedAtServer'
        ])
        && request.resource.data.photoUrl is string;
    }

    function isSelfProfileUpdate(userId) {
      return signedIn()
        && request.auth.uid == userId
        && request.resource.data.email == resource.data.email
        && request.resource.data.id == resource.data.id
        && request.resource.data.role == resource.data.role
        && request.resource.data.rolSistema == resource.data.rolSistema
        && request.resource.data.tipoUsuario == resource.data.tipoUsuario
        && request.resource.data.tituloUsuario == resource.data.tituloUsuario
        && request.resource.data.estadoUsuario == resource.data.estadoUsuario
        && request.resource.data.status == resource.data.status
        && request.resource.data.active == resource.data.active
        && request.resource.data.publicador == resource.data.publicador
        && request.resource.data.publicadorEco == resource.data.publicadorEco
        && request.resource.data.publicadorEvento == resource.data.publicadorEvento
        && request.resource.data.get('minorValidator', false) == resource.data.get('minorValidator', false)
        && request.resource.data.get('fechaNacimiento', '') == resource.data.get('fechaNacimiento', '')
        && request.resource.data.get('registroMenorEdad', false) == resource.data.get('registroMenorEdad', false)
        && request.resource.data.get('autorizacionAcudiente', false) == resource.data.get('autorizacionAcudiente', false)
        && request.resource.data.verificado == resource.data.verificado
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'firstName',
          'lastName',
          'phone',
          'tiempoIba',
          'visibleDirectorio',
          'mostrarTelefono',
          'permitirWhatsapp',
          'mostrarFoto',
          'updatedAt',
          'updatedAtServer'
        ])
        && request.resource.data.name is string
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.phone is string
        && request.resource.data.visibleDirectorio is bool
        && request.resource.data.mostrarTelefono is bool
        && request.resource.data.permitirWhatsapp is bool
        && request.resource.data.mostrarFoto is bool;
    }

    function isSelfInitialUserCreate(userId) {
      return signedIn()
        && request.auth.uid == userId
        && request.resource.data.id == userId
        && request.resource.data.email is string
        && request.resource.data.role == 'Usuario'
        && request.resource.data.rolSistema == 'Usuario'
        && request.resource.data.tipoUsuario == 'Asistente'
        && request.resource.data.tituloUsuario == 'Asistente'
        && (
          (
            request.resource.data.registroMenorEdad == false
            && request.resource.data.estadoUsuario == 'Activo'
            && request.resource.data.status == 'active'
            && request.resource.data.active == true
            && request.resource.data.minorValidationStatus == 'not_required'
          )
          || (
            request.resource.data.registroMenorEdad == true
            && request.resource.data.estadoUsuario == 'Pendiente representante'
            && request.resource.data.status == 'minor_pending_guardian'
            && request.resource.data.active == false
            && request.resource.data.autorizacionAcudiente == true
            && request.resource.data.guardianName is string
            && request.resource.data.guardianEmail is string
            && request.resource.data.guardianPhone is string
            && request.resource.data.minorValidationStatus == 'guardian_pending'
            && request.resource.data.minorValidationRequestId is string
          )
        )
        && request.resource.data.publicador == false
        && request.resource.data.publicadorEco == false
        && request.resource.data.publicadorEvento == false
        && request.resource.data.minorValidator == false
        && request.resource.data.verificado == false
        && request.resource.data.emailHash is string
        && request.resource.data.aceptoPoliticaDatos == true
        && request.resource.data.autorizacionTratamientoDatos == true
        && request.resource.data.fechaNacimiento is string
        && request.resource.data.fechaNacimiento.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.registroMenorEdad is bool
        && request.resource.data.autorizacionAcudiente is bool
        && request.resource.data.visibleDirectorio == false
        && request.resource.data.mostrarTelefono == false
        && request.resource.data.permitirWhatsapp == false
        && request.resource.data.mostrarFoto is bool
        && request.resource.data.keys().hasOnly([
          'id',
          'email',
          'name',
          'firstName',
          'lastName',
          'phone',
          'role',
          'rolSistema',
          'tipoUsuario',
          'tituloUsuario',
          'estadoUsuario',
          'status',
          'active',
          'publicador',
          'publicadorEco',
          'publicadorEvento',
          'minorValidator',
          'verificado',
          'emailHash',
          'aceptoPoliticaDatos',
          'fechaAceptacionPolitica',
          'politicaDatosVersion',
          'autorizacionTratamientoDatos',
          'tratamientoDatosAutorizadoAt',
          'fechaNacimiento',
          'registroMenorEdad',
          'autorizacionAcudiente',
          'guardianName',
          'guardianEmail',
          'guardianPhone',
          'minorValidationStatus',
          'minorValidationRequestId',
          'visibleDirectorio',
          'mostrarTelefono',
          'permitirWhatsapp',
          'mostrarFoto',
          'createdAt',
          'updatedAt',
          'createdAtServer',
          'updatedAtServer',
          'migratedFrom'
        ]);
    }

    function canValidateMinorUserActivation(userId) {
      return canValidateMinors()
        && resource.data.id == userId
        && resource.data.registroMenorEdad == true
        && request.resource.data.email == resource.data.email
        && request.resource.data.id == resource.data.id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'estadoUsuario',
          'status',
          'active',
          'minorValidationStatus',
          'minorValidationReviewedAt',
          'minorValidationReviewedByUserId',
          'minorValidationReviewedByEmail',
          'minorValidationRejectionReason',
          'updatedAt',
          'updatedAtServer'
        ])
        && (
          (
            request.resource.data.minorValidationStatus == 'approved'
            && request.resource.data.estadoUsuario == 'Activo'
            && request.resource.data.status == 'active'
            && request.resource.data.active == true
          )
          || (
            request.resource.data.minorValidationStatus == 'rejected'
            && request.resource.data.estadoUsuario == 'Bloqueado'
            && request.resource.data.status == 'minor_rejected'
            && request.resource.data.active == false
          )
          || (
            request.resource.data.minorValidationStatus == 'iba_pending'
            && request.resource.data.estadoUsuario == 'Pendiente IBA'
            && request.resource.data.status == 'minor_pending_iba'
            && request.resource.data.active == false
          )
        );
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isManager() || (canValidateMinors() && resource.data.registroMenorEdad == true));
      allow list: if isManager();
      allow create: if isSelfInitialUserCreate(userId);
      allow update: if (
          isManager()
          && request.resource.data.email == resource.data.email
          && request.resource.data.id == resource.data.id
        ) || canValidateMinorUserActivation(userId) || isSelfMembershipUpdate(userId) || isSelfPhotoUpdate(userId) || isSelfProfileUpdate(userId);
      allow delete: if signedIn()
        && request.auth.uid == userId
        && resource.data.registroMenorEdad == true
        && resource.data.active == false
        && resource.data.status == 'minor_pending_guardian';
    }

    match /membersDirectory/{memberId} {
      allow get, list: if signedIn()
        && (isManager() || isActiveMember())
        && resource.data.visibleDirectorio == true;
      allow create, update: if signedIn()
        && request.auth.uid == memberId
        && currentUserProfile().active == true
        && currentUserProfile().estadoUsuario == 'Activo'
        && currentUserProfile().tipoUsuario == 'Miembro'
        && request.resource.data.id == memberId
        && request.resource.data.tipoUsuario == 'Miembro'
        && request.resource.data.visibleDirectorio is bool
        && request.resource.data.mostrarTelefono is bool
        && request.resource.data.permitirWhatsapp is bool
        && request.resource.data.mostrarFoto is bool
        && request.resource.data.keys().hasOnly([
          'id',
          'nombre',
          'apellido',
          'fotoUrl',
          'telefono',
          'rol',
          'rolSistema',
          'tituloUsuario',
          'tipoUsuario',
          'ministerio',
          'grupoEco',
          'sector',
          'tiempoEnIBA',
          'visibleDirectorio',
          'mostrarTelefono',
          'permitirWhatsapp',
          'mostrarFoto',
          'mostrarMinisterio',
          'mostrarGrupoEco',
          'verificado',
          'estado',
          'fechaRegistro',
          'fechaActualizacion',
          'updatedAtServer'
        ])
        && (!request.resource.data.visibleDirectorio || (
          request.resource.data.rolSistema == currentUserProfile().rolSistema
          && request.resource.data.tituloUsuario == currentUserProfile().tituloUsuario
          && request.resource.data.estado == currentUserProfile().estadoUsuario
          && request.resource.data.verificado == currentUserProfile().verificado
        ));
      allow delete: if signedIn() && request.auth.uid == memberId;
    }

    match /memberRegistry/{ccHash} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if false;
      allow update: if signedIn()
        && resource.data.active == true
        && request.resource.data.ccHash == resource.data.ccHash
        && request.resource.data.emailHash == resource.data.emailHash
        && request.resource.data.estado == resource.data.estado
        && request.resource.data.active == resource.data.active
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'claimedUserId',
          'claimedEmailHash',
          'claimedAt',
          'claimStatus',
          'claimNotes',
          'updatedAt',
          'updatedAtServer'
        ])
        && (!('claimedUserId' in resource.data) || resource.data.claimedUserId == '' || resource.data.claimedUserId == request.auth.uid)
        && request.resource.data.claimedUserId == request.auth.uid
        && request.resource.data.claimedEmailHash == currentUserProfile().emailHash
        && (
          (
            resource.data.emailHash != ''
            && resource.data.emailHash == request.resource.data.claimedEmailHash
            && request.resource.data.claimStatus == 'validado'
          )
          || (
            (resource.data.emailHash == '' || resource.data.emailHash != request.resource.data.claimedEmailHash)
            && request.resource.data.claimStatus == 'pendiente_revision'
          )
        );
      allow delete: if false;
    }

    match /minorValidationRequests/{requestId} {
      allow get, list: if canValidateMinors();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'guardian_pending'
        && request.resource.data.id == requestId;
      allow update: if canValidateMinors()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'guardianApprovedAt',
          'validatedByUserId',
          'validatedByEmail',
          'validatedAt',
          'rejectionReason',
          'updatedAt',
          'updatedAtServer'
        ]);
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'guardian_pending';
    }
  }
}
